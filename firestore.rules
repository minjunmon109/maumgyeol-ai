rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny everything except a Google-authenticated owner's own sessions.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/sessions/{sessionId} {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      function validSession() {
        return request.resource.data.keys().hasOnly([
          'title', 'messages', 'createdAt', 'updatedAt', 'ownerUid'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'messages', 'createdAt', 'updatedAt', 'ownerUid'
        ])
        && request.resource.data.ownerUid == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 70
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 64
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.createdAt > 0
        && request.resource.data.updatedAt >= request.resource.data.createdAt;
      }
      allow get, list, delete: if isOwner();
      allow create, update: if isOwner() && validSession();
    }
  }
}
